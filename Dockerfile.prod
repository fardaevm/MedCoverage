# Stage 1: build
FROM python:3.12-slim AS builder
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl build-essential libffi-dev libgomp1 \
  && rm -rf /var/lib/apt/lists/*

ENV POETRY_HOME=/opt/poetry POETRY_VERSION=2.1.4
ENV PATH=${POETRY_HOME}/bin:${PATH}
RUN curl -sSL https://install.python-poetry.org | python3 -

RUN python -m venv /app/venv
ENV VIRTUAL_ENV=/app/venv PATH="/app/venv/bin:${PATH}" POETRY_VIRTUALENVS_CREATE=false

COPY backend/pyproject.toml backend/poetry.lock ./
RUN poetry install --only main --no-root --no-interaction

# Stage 2: runtime
FROM python:3.12-slim AS runner
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends libgomp1 curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/venv /app/venv
ENV VIRTUAL_ENV=/app/venv PATH="/app/venv/bin:${PATH}"

COPY . .

WORKDIR /app/backend
ENV PYTHONPATH=/app/backend

# S3 data sync entrypoint (downloads model data on startup)
COPY infra/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]